# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# ---- Database (Supabase Postgres) ----
# Pooled connection used by the app and Prisma Client at runtime.
# Supabase Dashboard -> Project Settings -> Database -> Connection pooling
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection used by Prisma migrations and the seed script.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional: separate connection string for the session table. Defaults to DATABASE_URL.
# SESSION_DATABASE_URL=""

# ---- Sessions ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# ---- Supabase Storage (vehicle photos) ----
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Server-only key. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="vehicle-images"

# ---- Public contact ----
DEALER_WHATSAPP="+263771234567"

# ---- Seed data ----
# Required in production. Existing users are never overwritten by the seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Platform Admin"

DEALER_OWNER_EMAIL="owner@example.com"
DEALER_OWNER_PASSWORD="choose-a-strong-password"
DEALER_OWNER_NAME="Dealer Owner"

DEALER_NAME="Zim Cars"
DEALER_SLUG="zim-cars"
DEALER_COMMISSION_RATE=3

# Set to true to insert the three demo vehicles on a fresh database.
SEED_SAMPLE_DATA=false
