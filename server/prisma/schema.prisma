generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Dealer {
  id                 String                @id @default(uuid())
  name               String                @db.VarChar(150)
  slug               String                @unique @db.VarChar(100)
  commissionRate     Float                 @default(3.00) @map("commission_rate")
  status             String                @default("pending_verification") @db.VarChar(30)
  createdAt          DateTime              @default(now()) @map("created_at")
  phone              String?               @db.VarChar(20)
  location           String?               @db.VarChar(100)
  address            String?
  description        String?
  logoUrl            String?               @map("logo_url")
  coverUrl           String?               @map("cover_url")
  plan               String                @default("trial") @db.VarChar(20)
  trialEndsAt        DateTime?             @map("trial_ends_at")
  subscriptionEndsAt DateTime?             @map("subscription_ends_at")
  lastPaymentAt      DateTime?             @map("last_payment_at")
  onboardingPaid     Boolean               @default(false) @map("onboarding_paid")
  subscriptionPaid   Boolean               @default(false) @map("subscription_paid")
  joinedAt           DateTime              @default(now()) @map("joined_at")
  approvedAt         DateTime?             @map("approved_at")
  approvedBy         String?               @map("approved_by")
  ownerFullName      String?               @map("owner_full_name") @db.VarChar(150)
  businessEmail      String?               @map("business_email") @db.VarChar(255)
  ecoCashName        String?               @map("ecocash_name") @db.VarChar(150)
  idNumber           String?               @map("id_number") @db.VarChar(50)
  verifiedAt         DateTime?             @map("verified_at")
  verifiedBy         String?               @map("verified_by")
  rejectionReason    String?               @map("rejection_reason")
  verificationStatus String                @default("pending") @map("verification_status") @db.VarChar(20)
  suspendedAt        DateTime?             @map("suspended_at")
  suspendedBy        String?               @map("suspended_by")
  suspensionReason   String?               @map("suspension_reason")
  auditLogs          AuditLog[]
  verifications      DealerVerification[]
  leads              Lead[]
  payments           Payment[]
  stories            DealerStory[]
  users              User[]
  vehicles           Vehicle[]
  appointments       ViewingAppointment[]
  disputes           LeadDispute[]

  @@map("dealers")
}

model DealerStory {
  id        String   @id @default(uuid())
  dealerId  String   @map("dealer_id")
  imageUrl  String   @map("image_url")
  caption   String?
  vehicleId String?  @map("vehicle_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @default(dbgenerated("NOW() + interval '24 hours'")) @map("expires_at")
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([expiresAt])
  @@map("dealer_stories")
}

model User {
  id               String              @id @default(uuid())
  dealerId         String?             @map("dealer_id")
  name             String              @db.VarChar(150)
  email            String              @unique @db.VarChar(255)
  passwordHash     String              @map("password_hash")
  role             String              @db.VarChar(30)
  createdAt        DateTime            @default(now()) @map("created_at")
  auditLogs        AuditLog[]
  paymentsRecorded CommissionPayment[] @relation("PaymentsRecordedBy")
  salesConfirmed   Sales[]             @relation("SalesConfirmedBy")
  assignedLeads    Lead[]              @relation("LeadAssignment")
  dealer           Dealer?             @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@map("users")
}

model Vehicle {
  id           String         @id @default(uuid())
  dealerId     String         @map("dealer_id")
  make         String         @db.VarChar(80)
  model        String         @db.VarChar(100)
  year         Int?
  price        Float
  currency     String         @default("USD") @db.VarChar(3)
  description  String?
  status       String         @default("available") @db.VarChar(20)
  createdAt    DateTime       @default(now()) @map("created_at")
  dutyPaid     Boolean?       @default(false) @map("duty_paid")
  fuelType     String?        @map("fuel_type") @db.VarChar(20)
  location     String?        @db.VarChar(80)
  mileage      Int?
  slug         String?        @unique @db.VarChar(120)
  transmission String?        @db.VarChar(20)
  videoUrl     String?        @map("video_url")
  leads        Lead[]
  sales        Sales[]
  images       VehicleImage[]
  dealer       Dealer         @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
  @@index([dealerId, status])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Lead {
  id             String               @id @default(uuid())
  dealerId       String               @map("dealer_id")
  vehicleId      String?              @map("vehicle_id")
  buyerName      String?              @map("buyer_name") @db.VarChar(150)
  buyerPhone     String               @map("buyer_phone") @db.VarChar(30)
  source         String               @db.VarChar(50)
  referralCode   String?              @map("referral_code") @db.VarChar(80)
  campaignId     String?              @map("campaign_id")
  campaign       Campaign?            @relation(fields: [campaignId], references: [id])
  status         String               @default("new") @db.VarChar(30)
  consentAt      DateTime?            @map("consent_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  ip             String?
  leadId         String?              @unique @map("lead_id_short") @db.VarChar(20)
  pageUrl        String?              @map("page_url")
  userAgent      String?              @map("user_agent")
  assignedToId   String?              @map("assigned_to_id")
  assignedTo     User?                @relation("LeadAssignment", fields: [assignedToId], references: [id])
  events         LeadEvent[]
  appointments   ViewingAppointment[]
  dealer         Dealer               @relation(fields: [dealerId], references: [id])
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id])
  sale           Sales?
  disputes       LeadDispute[]

  @@index([dealerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([dealerId, createdAt])
  @@index([dealerId, status])
  @@index([vehicleId, buyerPhone])
  @@index([assignedToId])
  @@map("leads")
}

model ViewingAppointment {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id])
  dealerId  String   @map("dealer_id")
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  scheduledAt DateTime @map("scheduled_at")
  status    String   @default("scheduled") @db.VarChar(30) // scheduled, completed, cancelled, no_show
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([leadId])
  @@index([dealerId])
  @@index([scheduledAt])
  @@map("viewing_appointments")
}

model Campaign {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  description String?
  source      String   @db.VarChar(50)
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  active      Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  leads       Lead[]

  @@map("campaigns")
}

model LeadDispute {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id])
  dealerId    String   @map("dealer_id")
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  reason      String
  details     String?
  status      String   @default("open") @db.VarChar(30) // open, investigating, resolved, rejected
  resolution  String?
  resolvedBy  String?  @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([dealerId])
  @@index([status])
  @@map("lead_disputes")
}

model LeadEvent {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  event     String   @db.VarChar(50)
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  actor     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_events")
}

model Sales {
  id               String              @id @default(uuid())
  leadId           String              @unique @map("lead_id")
  vehicleId        String              @map("vehicle_id")
  salePrice        Float               @map("sale_price")
  commissionRate   Float               @map("commission_rate")
  commissionAmount Float               @map("commission_amount")
  status           String              @default("pending") @db.VarChar(20)
  soldAt           DateTime            @default(now()) @map("sold_at")
  confirmedById    String?             @map("confirmed_by")
  confirmedAt      DateTime?           @map("confirmed_at")
  markedBy         String?             @map("marked_by")
  refCode          String?             @map("ref_code") @db.VarChar(80)
  evidenceUrl      String?             @map("evidence_url")
  evidenceNotes    String?             @map("evidence_notes")
  disputeReason    String?             @map("dispute_reason")
  disputedAt       DateTime?           @map("disputed_at")
  disputedBy       String?             @map("disputed_by")
  payments         CommissionPayment[]
  confirmedBy      User?               @relation("SalesConfirmedBy", fields: [confirmedById], references: [id])
  lead             Lead                @relation(fields: [leadId], references: [id])
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([soldAt])
  @@index([confirmedById])
  @@map("sales")
}

model CommissionPayment {
  id               String   @id @default(uuid())
  saleId           String   @map("sale_id")
  amount           Float
  paymentReference String?  @map("payment_reference") @db.VarChar(150)
  paidAt           DateTime @default(now()) @map("paid_at")
  recordedById     String   @map("recorded_by")
  recordedBy       User     @relation("PaymentsRecordedBy", fields: [recordedById], references: [id])
  sale             Sales    @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paidAt])
  @@index([recordedById])
  @@map("commission_payments")
}

model Payment {
  id         String    @id @default(uuid())
  dealerId   String    @map("dealer_id")
  type       String    @db.VarChar(30)
  amount     Float
  currency   String    @default("USD") @db.VarChar(3)
  method     String    @db.VarChar(30)
  reference  String?   @db.VarChar(150)
  proofUrl   String?   @map("proof_url")
  status     String    @default("pending") @db.VarChar(20)
  notes      String?
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  senderName String?   @map("sender_name") @db.VarChar(150)
  dealer     Dealer    @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model DealerVerification {
  id         String    @id @default(uuid())
  dealerId   String    @map("dealer_id")
  type       String    @db.VarChar(30)
  fileUrl    String    @map("file_url")
  notes      String?
  status     String    @default("pending") @db.VarChar(20)
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  dealer     Dealer    @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([status])
  @@map("dealer_verifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  dealerId   String?  @map("dealer_id")
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  action     String   @db.VarChar(50)
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])
  dealer     Dealer?  @relation(fields: [dealerId], references: [id])

  @@index([actorId])
  @@index([dealerId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
